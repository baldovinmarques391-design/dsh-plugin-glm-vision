{
  "name": "dsh-plugin-glm-vision",
  "version": "2.1.0",
  "description": "Image translation for non-multimodal models via GLM-4V-Flash: intercepts images, generates descriptions, injects as text.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./lib/*": "./lib/*",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baldovinmarques391-design/dsh-plugin-glm-vision.git"
  },
  "scripts": {
    "lint": "echo 'no linter configured'",
    "test": "node test/run-tests.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "vision",
    "glm",
    "image",
    "multimodal"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.2.0-0",
    "@deepseek-ai/cordis": ">=4.0.0 <5.0.0"
  }
}
